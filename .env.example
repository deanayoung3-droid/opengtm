# Settings and secrets. `pnpm setup` writes .env for you; or copy this file to .env and fill it in.
# Never commit .env.

# --- Required ----------------------------------------------------------------------------------------
# Database password (docker compose creates the database with it). Long and random.
POSTGRES_PASSWORD=
# Dashboard login (HTTP basic auth). Use a long password, and HTTPS once it's on the internet.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Signs one-click unsubscribe links and encrypts imported mailbox passwords. 32+ random characters.
# Never change it after you start sending: old unsubscribe links and saved mailbox logins depend on it.
UNSUBSCRIBE_SECRET=
# AI model key for config/llm.yaml (OpenAI by default; see config/examples for Anthropic or a local model).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=ollama
# LOCAL_LLM_MODEL=

# --- Recommended -------------------------------------------------------------------------------------
# Your domain for HTTPS with `docker compose --profile https up -d` (e.g. gtm.yourcompany.com).
GTM_DOMAIN=
# The dashboard's public address, e.g. https://gtm.yourcompany.com. Used for unsubscribe links in emails
# and for links in alert emails. Empty = emails use a mailto unsubscribe (reply "stop" still works).
PUBLIC_BASE_URL=
# Your team's time zone (IANA name): schedules, daily caps and every time in the dashboard use it.
# Emails always go out in each recipient's own business hours.
TEAM_TIMEZONE=America/Los_Angeles
# Email verification (zerobounce.net): bounces burn mailboxes, so verify before sending.
ZEROBOUNCE_API_KEY=

# --- Lead source (optional) --------------------------------------------------------------------------
# AI Ark people search (docs.ai-ark.com). Set AI_ARK_TERMS_OK=1 only after reading their terms for
# outbound use. Without a lead source, import leads from a CSV (see docs/CONFIGURATION.md).
AI_ARK_API_KEY=
AI_ARK_TERMS_OK=0
# Find people on companies' own websites (contact/team pages). Set to 1 only if that fits your policy.
GTM_COMPANY_SITE_SOURCE_OK=0

# --- Branding (optional) -----------------------------------------------------------------------------
# The product name shown in the dashboard and alert emails.
# APP_NAME=OpenGTM
# Port docker compose publishes the dashboard on.
# APP_PORT=8080

# --- Mailboxes ---------------------------------------------------------------------------------------
# Easiest: upload your mailbox vendor's CSV on the Channels page (each login is tested; passwords are
# stored encrypted with a key derived from UNSUBSCRIBE_SECRET, or from this if set).
MAILBOX_SECRET_KEY=
# Or define mailboxes here, one prefix each (MB1, MB2, ...), and register each with `pnpm gtm add-mailbox` (see docs/CONFIGURATION.md):
#   SMTP/IMAP:  MB1_SMTP_HOST, MB1_SMTP_PORT, MB1_SMTP_USER, MB1_SMTP_PASS, MB1_IMAP_HOST, MB1_IMAP_PORT
#   Gmail API:  MB1_GOOGLE_CLIENT_ID, MB1_GOOGLE_CLIENT_SECRET, MB1_GOOGLE_REFRESH_TOKEN
#   Microsoft:  MB1_MS_TENANT_ID, MB1_MS_CLIENT_ID, MB1_MS_CLIENT_SECRET, MB1_MS_REFRESH_TOKEN
# For `pnpm gtm connect-google` (gets a Gmail API refresh token for a mailbox):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Seed inboxes for placement tests use the same form, e.g. SEED1_IMAP_HOST, SEED1_IMAP_USER, SEED1_IMAP_PASS.

# --- Alerts (config/engine.yaml alerts.channels) ------------------------------------------------------
# Team emails go out from your first active mailbox by default; or set a dedicated SMTP server:
ALERT_SMTP_URL=                 # smtp://user:pass@smtp.example.com:587
ALERT_FROM=                     # sender address for alerts when ALERT_SMTP_URL is set
ALERT_EMAIL_TO=                 # comma-separated, for the "email" channel
NTFY_TOPIC=                     # phone push via the ntfy app; use a long private topic name
NTFY_SERVER=https://ntfy.sh
SLACK_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=             # SMS, critical alerts only
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=                   # comma-separated E.164 numbers

# --- CRM (optional) ----------------------------------------------------------------------------------
# Hot leads and meetings are POSTed here as JSON (Zapier, Make, n8n, or your CRM's webhook).
CRM_WEBHOOK_URL=

# --- Backups (docker compose --profile backup) --------------------------------------------------------
RCLONE_REMOTE=                  # e.g. b2:my-gtm-backups (needs ./secrets/rclone.conf); empty = ./backups only
BACKUP_KEEP_DAYS=14

# --- Development ---------------------------------------------------------------------------------------
# DATABASE_URL is set by docker compose. For `pnpm dev` on your machine, point it at a local Postgres.
# DATABASE_URL=postgres://gtm:gtm@localhost:5432/gtm
# GTM_DRY_RUN=1                 # fake mailboxes and mock data: try the whole app without sending anything
# DASHBOARD_AUTH=off            # next dev only: skip the login (ignored in production builds)
LOG_LEVEL=info
